# Environment convention:
#   .env             -> DEV project (qibragcqrxidpyoqapiv). Daily driver. test_otp enabled here.
#   .env.production  -> PROD project. Created at launch. Release builds only. NO test_otp.
#
# Production does NOT exist yet — it will be a separate, clean Supabase project
# provisioned at launch. Until then, only .env (dev) is used.
#
# Usage:
#   flutter run --dart-define-from-file=.env                 (dev)
#   flutter build <target> --dart-define-from-file=.env.production   (at launch)
#
# Both .env files are gitignored. Only this .env.example is committed.

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
SUPABASE_SECRET_KEY=sb_secret_your-key

# Legacy JWT keys (keep for Supabase CLI local dev)
SUPABASE_ANON_KEY=your-anon-jwt-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt-key

# Google Maps
GOOGLE_MAPS_API_KEY=your-google-maps-key

# Sentry
SENTRY_DSN=https://your-key@sentry.io/your-project

# Eskiz.uz (SMS)
ESKIZ_API_TOKEN=your-eskiz-token

# Firebase (FCM only — no Analytics)
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id

# PostHog
POSTHOG_API_KEY=your-posthog-key
POSTHOG_HOST=https://eu.posthog.com
