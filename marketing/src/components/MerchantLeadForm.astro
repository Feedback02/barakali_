---
import { asLang, localeHome, useTranslations } from '../i18n/utils';

const lang = asLang(Astro.currentLocale);
const t = useTranslations(lang);
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const privacyPath = `${localeHome[lang]}privacy`;
const consent = t('form.consent').split('{link}');

const labelClass = 'text-sm font-medium text-ink';
const inputClass =
  'mt-1.5 w-full rounded-xl border border-black/10 bg-cream/60 px-4 py-3 text-ink outline-none transition placeholder:text-ink-soft/60 focus:border-brand focus:bg-white focus:ring-4 focus:ring-brand/15';
---

<section id="partner" class="mx-auto max-w-2xl px-4 py-16 sm:px-6 sm:py-24">
  <h2 class="text-3xl font-bold tracking-tight text-ink">
    {t('merchant.title')}
  </h2>
  <p class="mt-3 text-lg text-ink-soft">{t('merchant.subtitle')}</p>

  <div
    class="mt-8 rounded-3xl bg-white p-6 shadow-xl shadow-black/5 ring-1 ring-black/5 sm:p-8"
  >
    <form id="merchant-form" data-locale={lang} data-required={t('merchant.required')} data-error={t('merchant.error')} data-captcha={t('form.captchaError')} data-sending={t('merchant.sending')} novalidate>
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="sm:col-span-2">
          <label class={labelClass} for="m-business"
            >{t('merchant.business')}</label
          >
          <input
            id="m-business"
            name="business_name"
            type="text"
            required
            aria-required="true"
            class={inputClass}
          />
        </div>
        <div>
          <label class={labelClass} for="m-contact"
            >{t('merchant.contact')}</label
          >
          <input
            id="m-contact"
            name="contact_name"
            type="text"
            class={inputClass}
          />
        </div>
        <div>
          <label class={labelClass} for="m-phone">{t('merchant.phone')}</label>
          <input
            id="m-phone"
            name="phone"
            type="tel"
            required
            aria-required="true"
            class={inputClass}
          />
        </div>
        <div>
          <label class={labelClass} for="m-email">{t('merchant.email')}</label>
          <input id="m-email" name="email" type="email" class={inputClass} />
        </div>
        <div>
          <label class={labelClass} for="m-city">{t('merchant.city')}</label>
          <input id="m-city" name="city" type="text" class={inputClass} />
        </div>
        <div class="sm:col-span-2">
          <label class={labelClass} for="m-message"
            >{t('merchant.message')}</label
          >
          <textarea id="m-message" name="message" rows="3" class={inputClass}
          ></textarea>
        </div>
      </div>

      {
        turnstileSiteKey && (
          <div class="mt-5 flex">
            <div class="js-turnstile" data-sitekey={turnstileSiteKey} />
          </div>
        )
      }

      <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center">
        <button
          type="submit"
          data-label={t('merchant.submit')}
          class="rounded-xl bg-brand px-6 py-3 font-semibold text-white shadow-sm transition hover:bg-brand-strong active:scale-[0.98] disabled:opacity-60"
        >
          {t('merchant.submit')}
        </button>
        <p class="text-xs leading-relaxed text-ink-soft">
          {consent[0]}<a href={privacyPath} class="text-brand hover:underline"
            >{t('form.consentLink')}</a
          >{consent[1]}
        </p>
      </div>

      <p
        id="merchant-msg"
        role="status"
        aria-live="polite"
        class="mt-3 text-sm text-terracotta-strong empty:hidden"
      >
      </p>
    </form>

    <p
      id="merchant-success"
      role="status"
      aria-live="polite"
      class="hidden items-center gap-3 font-medium text-brand-strong"
    >
      <span
        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-soft text-brand"
        aria-hidden="true"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          class="h-5 w-5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4.5 12.75l6 6 9-13.5"></path>
        </svg>
      </span>
      {t('merchant.success')}
    </p>
  </div>
</section>

<script>
  import { insertLead } from '../lib/leads';
  import {
    renderTurnstile,
    resetTurnstile,
    turnstileToken,
  } from '../lib/turnstile';

  // Bound on astro:page-load so it re-initializes after client-side (view
  // transition) navigation, not just the first full load.
  function initMerchantForm() {
    const form = document.getElementById(
      'merchant-form',
    ) as HTMLFormElement | null;
    const msg = document.getElementById('merchant-msg');
    const success = document.getElementById('merchant-success');
    if (!form || !msg || !success || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    const button = form.querySelector(
      'button[type=submit]',
    ) as HTMLButtonElement;
    const captcha = form.querySelector('.js-turnstile') as HTMLElement | null;
    renderTurnstile(captcha);

    const show = (text: string) => {
      msg.textContent = text;
    };

    const trimmed = (data: FormData, key: string) =>
      String(data.get(key) ?? '').trim();

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      show('');

      const data = new FormData(form);
      const businessName = trimmed(data, 'business_name');
      const phone = trimmed(data, 'phone');
      if (!businessName || !phone) {
        show(form.dataset.required ?? '');
        return;
      }

      const token = turnstileToken(captcha);
      if (captcha && !token) {
        show(form.dataset.captcha ?? '');
        return;
      }

      const original = button.textContent;
      button.disabled = true;
      button.textContent = form.dataset.sending ?? '';

      try {
        await insertLead(
          'merchant_leads',
          {
            business_name: businessName,
            contact_name: trimmed(data, 'contact_name') || null,
            phone,
            email: trimmed(data, 'email') || null,
            city: trimmed(data, 'city') || null,
            message: trimmed(data, 'message') || null,
            locale: form.dataset.locale,
          },
          token,
        );
        form.classList.add('hidden');
        success.classList.remove('hidden');
        success.classList.add('flex');
      } catch {
        show(form.dataset.error ?? '');
        resetTurnstile(captcha);
        button.disabled = false;
        button.textContent = original;
      }
    });
  }

  document.addEventListener('astro:page-load', initMerchantForm);
</script>
