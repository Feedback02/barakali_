---
import { asLang, localeHome, useTranslations } from '../i18n/utils';

const lang = asLang(Astro.currentLocale);
const t = useTranslations(lang);
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const privacyPath = `${localeHome[lang]}privacy`;
const consent = t('form.consent').split('{link}');
---

<section id="waitlist" class="bg-brand-soft/40">
  <div class="mx-auto max-w-2xl px-4 py-16 text-center sm:px-6 sm:py-24">
    <h2 class="text-3xl font-bold tracking-tight text-ink">
      {t('waitlist.title')}
    </h2>
    <p class="mx-auto mt-3 max-w-xl text-lg text-ink-soft">
      {t('waitlist.subtitle')}
    </p>

    <div
      class="mx-auto mt-8 max-w-lg rounded-3xl bg-white p-6 shadow-xl shadow-black/5 ring-1 ring-black/5 sm:p-8"
    >
      <form id="waitlist-form" data-locale={lang} data-missing={t('waitlist.missing')} data-error={t('waitlist.error')} data-captcha={t('form.captchaError')} data-sending={t('waitlist.sending')} novalidate>
        <div class="flex flex-col gap-3 sm:flex-row">
          <label class="sr-only" for="waitlist-contact"
            >{t('waitlist.contactLabel')}</label
          >
          <input
            id="waitlist-contact"
            name="contact"
            type="text"
            autocomplete="email"
            placeholder={t('waitlist.placeholder')}
            class="w-full rounded-xl border border-black/10 bg-cream/60 px-4 py-3 text-ink outline-none transition placeholder:text-ink-soft/60 focus:border-brand focus:bg-white focus:ring-4 focus:ring-brand/15"
          />
          <button
            type="submit"
            data-label={t('waitlist.submit')}
            class="shrink-0 rounded-xl bg-brand px-6 py-3 font-semibold text-white shadow-sm transition hover:bg-brand-strong active:scale-[0.98] disabled:opacity-60"
          >
            {t('waitlist.submit')}
          </button>
        </div>

        {
          turnstileSiteKey && (
            <div class="mt-4 flex justify-center">
              <div class="js-turnstile" data-sitekey={turnstileSiteKey} />
            </div>
          )
        }

        <p
          id="waitlist-msg"
          role="status"
          aria-live="polite"
          class="mt-3 text-sm text-terracotta-strong empty:hidden"
        >
        </p>

        <p class="mt-4 text-xs leading-relaxed text-ink-soft">
          {consent[0]}<a href={privacyPath} class="text-brand hover:underline"
            >{t('form.consentLink')}</a
          >{consent[1]}
        </p>
      </form>

      <p
        id="waitlist-success"
        role="status"
        aria-live="polite"
        class="hidden items-center gap-3 text-left font-medium text-brand-strong"
      >
        <span
          class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-soft text-brand"
          aria-hidden="true"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            class="h-5 w-5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4.5 12.75l6 6 9-13.5"></path>
          </svg>
        </span>
        {t('waitlist.success')}
      </p>
    </div>
  </div>
</section>

<script>
  import { insertLead } from '../lib/leads';
  import {
    renderTurnstile,
    resetTurnstile,
    turnstileToken,
  } from '../lib/turnstile';

  // Bound on astro:page-load so it re-initializes after client-side (view
  // transition) navigation, not just the first full load.
  function initWaitlistForm() {
    const form = document.getElementById(
      'waitlist-form',
    ) as HTMLFormElement | null;
    const msg = document.getElementById('waitlist-msg');
    const success = document.getElementById('waitlist-success');
    if (!form || !msg || !success || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    const button = form.querySelector(
      'button[type=submit]',
    ) as HTMLButtonElement;
    const captcha = form.querySelector('.js-turnstile') as HTMLElement | null;
    renderTurnstile(captcha);

    const show = (text: string) => {
      msg.textContent = text;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      show('');

      const contact = String(new FormData(form).get('contact') ?? '').trim();
      if (!contact) {
        show(form.dataset.missing ?? '');
        return;
      }

      const token = turnstileToken(captcha);
      if (captcha && !token) {
        show(form.dataset.captcha ?? '');
        return;
      }

      const isEmail = contact.includes('@');
      const original = button.textContent;
      button.disabled = true;
      button.textContent = form.dataset.sending ?? '';

      try {
        await insertLead(
          'waitlist_signups',
          {
            email: isEmail ? contact : null,
            phone: isEmail ? null : contact,
            locale: form.dataset.locale,
            source: 'waitlist',
          },
          token,
        );
        form.classList.add('hidden');
        success.classList.remove('hidden');
        success.classList.add('flex');
      } catch {
        show(form.dataset.error ?? '');
        resetTurnstile(captcha);
        button.disabled = false;
        button.textContent = original;
      }
    });
  }

  document.addEventListener('astro:page-load', initWaitlistForm);
</script>
