---
import { asLang, useTranslations } from '../i18n/utils';

const lang = asLang(Astro.currentLocale);
const t = useTranslations(lang);

// Each step is paired with the real app screen for that moment, localized to the
// current page (screenshots captured per locale in public/app/<screen>-<lang>.webp).
const steps = [
  {
    n: '1',
    title: t('how.step1.title'),
    text: t('how.step1.text'),
    shot: `/app/home-${lang}.webp`,
  },
  {
    n: '2',
    title: t('how.step2.title'),
    text: t('how.step2.text'),
    shot: `/app/offer-${lang}.webp`,
  },
  {
    n: '3',
    title: t('how.step3.title'),
    text: t('how.step3.text'),
    shot: `/app/pickup-${lang}.webp`,
  },
];
---

<section id="how" class="bg-brand-soft/30">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
    <h2 class="text-center text-3xl font-bold tracking-tight text-ink">
      {t('how.title')}
    </h2>
    <div class="mt-14 grid gap-14 sm:grid-cols-3 sm:gap-8">
      {
        steps.map((step) => (
          <div class="flex flex-col items-center text-center">
            <div
              class="w-full max-w-[230px] rounded-[2rem] border-[6px] border-ink/85 bg-ink/85 shadow-xl"
            >
              <img
                src={step.shot}
                width="540"
                height="1115"
                alt={step.title}
                loading="lazy"
                decoding="async"
                class="w-full rounded-[1.6rem]"
              />
            </div>
            <span class="mt-7 flex h-11 w-11 items-center justify-center rounded-full bg-brand text-lg font-bold text-white">
              {step.n}
            </span>
            <h3 class="mt-4 text-lg font-semibold text-ink">{step.title}</h3>
            <p class="mt-2 max-w-xs leading-relaxed text-ink-soft">{step.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
