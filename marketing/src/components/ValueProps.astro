---
import { asLang, useTranslations } from '../i18n/utils';

const lang = asLang(Astro.currentLocale);
const t = useTranslations(lang);

const cards = [
  {
    title: t('value.save.title'),
    text: t('value.save.text'),
    // wallet
    icon: 'M2.25 8.25h19.5M2.25 9a2.25 2.25 0 0 1 2.25-2.25h15A2.25 2.25 0 0 1 21.75 9v8.25a2.25 2.25 0 0 1-2.25 2.25h-15A2.25 2.25 0 0 1 2.25 17.25V9Zm15.75 4.5h.008v.008H18v-.008Z',
  },
  {
    title: t('value.planet.title'),
    text: t('value.planet.text'),
    // leaf / sparkle
    icon: 'M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z',
  },
  {
    title: t('value.local.title'),
    text: t('value.local.text'),
    // map pin
    icon: 'M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z',
  },
];
---

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
  <h2 class="text-center text-3xl font-bold tracking-tight text-ink">
    {t('value.title')}
  </h2>
  <div class="mt-10 grid gap-6 sm:grid-cols-3">
    {
      cards.map((card) => (
        <div class="rounded-brand bg-white p-6 shadow-sm ring-1 ring-black/5">
          <span class="flex h-12 w-12 items-center justify-center rounded-brand bg-brand-soft text-brand">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="h-6 w-6"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d={card.icon} />
            </svg>
          </span>
          <h3 class="mt-4 text-lg font-semibold text-ink">{card.title}</h3>
          <p class="mt-2 leading-relaxed text-ink-soft">{card.text}</p>
        </div>
      ))
    }
  </div>
</section>
