---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { asLang, useTranslations } from '../i18n/utils';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const lang = asLang(Astro.currentLocale);
const t = useTranslations(lang);
const title = t('meta.title');
const description = t('meta.description');
const canonical = new URL(Astro.url.pathname, Astro.site);
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

// hreflang alternates: strip the locale prefix to the shared page path, then
// build an absolute URL per locale (ru at root, uz/en prefixed).
const basePath = Astro.url.pathname.replace(/^\/(?:uz|en)(?=\/|$)/, '') || '/';
const alternates = {
  ru: new URL(basePath, Astro.site).href,
  uz: new URL(basePath === '/' ? '/uz/' : `/uz${basePath}`, Astro.site).href,
  en: new URL(basePath === '/' ? '/en/' : `/en${basePath}`, Astro.site).href,
};
const ogLocale: Record<string, string> = {
  ru: 'ru_RU',
  uz: 'uz_UZ',
  en: 'en_US',
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/barakali-logo.png" />
    <link
      rel="preload"
      href="/fonts/noto-sans-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      lang === 'ru' && (
        <link
          rel="preload"
          href="/fonts/noto-sans-cyrillic-wght-normal.woff2"
          as="font"
          type="font/woff2"
          crossorigin
        />
      )
    }
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ru" href={alternates.ru} />
    <link rel="alternate" hreflang="uz" href={alternates.uz} />
    <link rel="alternate" hreflang="en" href={alternates.en} />
    <link rel="alternate" hreflang="x-default" href={alternates.ru} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2d7d46" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content={new URL('/barakali-logo.png', Astro.site)}
    />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta name="twitter:card" content="summary" />
    <ClientRouter />
    {
      turnstileSiteKey && (
        <script
          src="https://challenges.cloudflare.com/turnstile/v0/api.js"
          async
          defer
          is:inline
        />
      )
    }
  </head>
  <body class="min-h-screen bg-cream text-ink">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
