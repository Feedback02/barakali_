# Environment variables for the marketing site. Set these in Cloudflare Pages
# (Settings -> Environment variables) for the deployed site; copy to a local
# `.env` for local dev. Point at the PROD Supabase project for the live site.

# --- Supabase (read by the /api/lead Pages Function, server-side) ---
# The lead insert happens in the function now, so the key is NOT shipped to the
# browser. The function prefers the service-role key (below) and falls back to
# these. PUBLIC_ vars are also available to the function at runtime.
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# --- Cloudflare Turnstile (CAPTCHA) ---
# PUBLIC site key: shipped to the browser to render the widget. When empty, no
# widget renders and forms submit without a CAPTCHA (graceful).
PUBLIC_TURNSTILE_SITE_KEY=

# --- Function-only secrets (set in Cloudflare, NOT needed for local dev) ---
# TURNSTILE_SECRET: Turnstile secret key. When set, /api/lead REQUIRES a valid
#   token, enforcing the CAPTCHA.
# SUPABASE_SERVICE_ROLE_KEY: optional. If set, the function inserts with the
#   service role (RLS bypass), so the public anon INSERT path can be locked down.
# These are secrets: set them as encrypted env vars in Cloudflare, never commit.
# TURNSTILE_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=
